# Triton Model Configuration Template
# This template shows all available configuration options for PyTorch models

name: "MODEL_NAME"
backend: "pytorch"
max_batch_size: 32

# ============================================================================
# DYNAMIC BATCHING - THE CORE LEARNING OBJECTIVE
# ============================================================================
# Dynamic batching is Triton's key feature for GPU efficiency. Instead of
# processing requests one-by-one, Triton accumulates multiple requests into
# a single batch, dramatically improving throughput.
#
# How it works:
# 1. Request arrives at Triton
# 2. Triton waits up to 'max_queue_delay_microseconds' for more requests
# 3. Once delay expires OR batch reaches 'max_batch_size', execute inference
# 4. Triton splits results back to individual requests
#
# Trade-offs:
# - Higher max_batch_size → Better GPU utilization, higher throughput
# - Higher max_queue_delay → Larger batches but higher latency
# - Lower max_queue_delay → Lower latency but smaller batches
# ============================================================================

dynamic_batching {
  # Maximum time (microseconds) to wait for additional requests before
  # executing the current batch.
  #
  # Example: 5000μs = 5ms
  # - At low QPS: Most requests wait ~5ms, batches are small (1-4)
  # - At high QPS: Batches fill quickly, often hitting max_batch_size
  #
  # Tuning guidance:
  # - Latency-sensitive: 1000-5000μs (1-5ms)
  # - Throughput-optimized: 10000-50000μs (10-50ms)
  max_queue_delay_microseconds: 5000

  # Preferred batch sizes for optimal GPU utilization.
  # Triton will try to create batches of these sizes when possible.
  #
  # Why this matters:
  # - GPUs are most efficient with specific batch sizes (powers of 2)
  # - Helps Triton make smarter batching decisions
  preferred_batch_size: [4, 8, 16, 32]

  # Control whether to preserve request ordering.
  # - true: Maintain FIFO order (adds ~1-2ms latency overhead)
  # - false: Prioritize throughput over ordering
  preserve_ordering: false

  # Priority levels for different request sources (advanced feature).
  # Higher priority requests are batched first.
  # default_priority_level: 0
  # default_queue_policy {
  #   timeout_action: REJECT
  #   default_timeout_microseconds: 10000000
  #   allow_timeout_override: true
  #   max_queue_size: 128
  # }
}

# ============================================================================
# INPUT SPECIFICATION
# ============================================================================
# Define the expected input tensors for the model

input [
  {
    name: "user_ids"
    data_type: TYPE_INT64
    dims: [-1]  # [-1] means dynamic batch size, actual shape: [batch_size]
  },
  {
    name: "item_ids"
    data_type: TYPE_INT64
    dims: [-1]  # Shape: [batch_size]
  }
]

# ============================================================================
# OUTPUT SPECIFICATION
# ============================================================================
# Define the output tensors from the model

output [
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [1]  # Shape: [batch_size, 1]
  }
]

# ============================================================================
# INSTANCE GROUPS - GPU/CPU ALLOCATION
# ============================================================================
# Control how many model instances to run and where (GPU/CPU)
#
# For CPU-only deployment (your setup):
instance_group [
  {
    count: 1              # Number of model instances
    kind: KIND_CPU        # Use KIND_GPU for GPU deployment
  }
]

# For GPU deployment (future):
# instance_group [
#   {
#     count: 1            # Number of instances per GPU
#     kind: KIND_GPU
#     gpus: [0]           # Which GPU IDs to use
#   }
# ]

# ============================================================================
# OPTIMIZATION FLAGS (optional)
# ============================================================================
# Additional optimization settings

# optimization {
#   # Use CUDA graphs for faster kernel launches (GPU only)
#   cuda {
#     graphs: true
#   }
# }

# ============================================================================
# VERSION POLICY
# ============================================================================
# Control which model versions to serve
# - 'latest': Serve only the highest numbered version
# - 'all': Serve all versions
# - 'specific': Serve specific versions

version_policy: {
  latest: {
    num_versions: 1
  }
}
